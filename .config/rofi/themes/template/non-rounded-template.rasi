/* ROUNDED THEME FOR ROFI */
/* Author: Newman Sanchez (https://github.com/newmanls) */

* {
    /* font:   "JetBrainsMono Nerd Font 12"; */

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:       center;
    anchor:         center;
    width:          800;
    border-radius:  0px;
    fullscreen:     false;

    background-color:   @bg0;
    border-color:       @bg3;
    border:             2px;
}

mainbox {
    enabled:    true;
    padding:    30px;
    spacing:    10px;
    children:   [ "inputbar", "message", "listview", "mode-switcher" ];
}

inputbar {
    background-color:   @bg1;
    border-color:       @bg3;

    border:         2px;
    border-radius:  0px;

    padding:    8px 16px;
    spacing:    10px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @fg2;
}

entry {
    placeholder:        "Search";
    placeholder-color:  @fg3;
}

message {
    margin:             12px 0 0;
    border-radius:      0px;
    border-color:       @bg2;
    background-color:   @bg2;
}

textbox {
    padding:    8px 24px;
}

listview {
    background-color:   transparent;

    // margin:     12px 0 0;
    lines:      7;
    columns:    2;

    fixed-height: true;
    fixed-columns: true;
    spacing:    5px;
    layout:     vertical;
    cycle:      true;
    dynamic:    true;
    reverse:    false;
    scrollbar:  false;
}

element {
    padding:        8px 16px;
    spacing:        8px;
    border-radius:  0px;
}

element normal.active {
    text-color: @bg3;
}

element alternate active {
    text-color: @bg3;
}

element selected.normal, element selected.active {
    background-color:   @bg3;
}

element-icon {
    size:           1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.0;
    horizontal-align:            0.0;
}

mode-switcher {
    enabled:            true;
    spacing:            10px;
    margin:             10px;
    padding:            0px 70px;
    background-color:   transparent;
}

button {
    padding:            10px;
    border-radius:      0px;
    background-color:   transparent;
    cursor:             pointer;
    border:             0px;
    border-color:       @bg3;
    vertical-align:     0.0;
}
button selected {
    background-color:            @bg2;
    text-color:                  inherit;
    border:                      2px 2px 2px 2px;
    border-radius:               0px;
    border-color:                @bg3;
}