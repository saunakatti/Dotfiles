{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/home/onni/.config/fastfetch/logos/banner.txt",
        "padding": {
            "top": 0,
            "left": 2,
            "right": 2
    	},
      "color": {
            "1": "white"
      }

    },
        "display": {
        "separator": " ",
        "color": {
            "keys": "2",
            "title": "1"
        },
        "key": {
        "width": 20,       // Aligns keys to this width
        "type": "string"   // string, icon, both, or none
        },
        "percent": {
            "type": 9,
            "color": {
                "green": "dim_green"
            }
        }
    },
         "modules": [
        {
            "type": "title",
            "keyColor": "2",
            "key": "    User",
            "outputColor": "dim_green"
        },
        {
            "key": "    Distro",
            "keyColor": "2",
            "type": "os"

        },
        {
            "key": "    Kernel",
            "keyColor": "2",
            "type": "kernel"
        },
        {
            "key": "    Host",
            "keyColor": "2",
            "type": "host"

        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "    Packages",
            "keyColor": "2"
        },
        {
            "type": "shell",
            "key": "    Shell",
            "keyColor": "2"
        },
        {
            "type": "terminal",
            "key": "    Terminal",
            "keyColor": "2"
        },
        {
            "type": "cpu",
            "format": "{1} @ {7}",
            "key": "    CPU",
            "keyColor": "2"
        },
        {
            "type": "gpu",
            "format": "{1} {2}",
            "key": "    GPU",
            "keyColor": "2"
        },
        {
            "type": "gpu",
            "format": "{3}",
            "key": "    GPU Drivers",
            "keyColor": "2"
        },
        {
            "type": "memory",
            "key": "    Memory",
            "keyColor": "2"
        },
        {
            "type": "disk",
            "key": "   Disk",
            "keyColor": "2",
            "format": "{#bold_1}{10}:{#} {1} / {2} ({3})"
        },
        {
            "type": "uptime",
            "key": "    Uptime",
            "keyColor": "2"
        },
        {
            "type": "command",
            "key": "  󱦟  Age",
            "keyColor": "2",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "datetime",
            "key": "  󰭖  DateTime",
            "keyColor": "2",
            "format": "{14}:{18}:{20} {23}-{4}-{1} {#2}(Day {10}){#}"
        }
       
        
    ]
}