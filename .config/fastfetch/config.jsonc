{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    //"source": "/home/onni/.config/fastfetch/logos/banner.txt",
    "type": "auto",
    "padding": {
      "top": 10,
      "left": 2,
      "right": 4
    },
    "color": {
      "1": "#cba6f7"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "2",
      "title": "1"
    },
    "key": {
      "width": 20, // Aligns keys to this width
      "type": "string" // string, icon, both, or none
    },
    "percent": {
      "type": 9,
      "color": {
        "green": "2"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────────Software─────────────────────────┐"
    },
    {
      "type": "title",
      "keyColor": "2",
      "key": "    User",
    },
    {
      "type": "os",
      "keyWidth": 20,
      "key": "    OS",
      "keyColor": "2", // = color4
    },
    {
      "type": "kernel",
      "key": "    Kernel",
      "keyColor": "2",
    },
    {
      "type": "packages",
      "format": "{pacman} (pacman) {flatpak-all} (flatpak) {appimage} (AppImage)",
      "key": "    Packages",
      "keyColor": "2",
    },
    {
      "type": "shell",
      "key": "    Shell",
      "keyColor": "2",
    },
    {
      "type": "terminal",
      "key": "    Terminal",
      "keyColor": "2",
    },
    {
      "type": "terminalfont",
      "key": "  󰛖  Terminalfont",
      "keyColor": "2",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────────Display──────────────────────────┐"
    },
    {
      "type": "wm",
      "key": "    WM",
      "keyColor": "2",
    },
    {
      "type": "display",
      "key": "  󰍹  Display",
      "format": "{name} : {width}x{height} @ {refresh-rate} Hz",
      "keyColor": "2"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────────Hardware─────────────────────────┐"
    },
    {
      "type": "host",
      "key": "    Host",
      "keyColor": "2"
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": "    CPU",
      "keyColor": "2"
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": "    GPU",
      "keyColor": "2"
    },
    {
      "type": "gpu",
      "format": "{3}",
      "key": "    GPU Drivers",
      "keyColor": "2"
    },
    {
      "type": "memory",
      "key": "    Memory",
      "keyColor": "2"
    },
    {
      "type": "swap",
      "key": "  󰾴  Swap",
      "keyColor": "2"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────────Storage──────────────────────────┐"
    },
    {
      "type": "disk",
      "key": "    Disk",
      "keyColor": "2"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────Uptime / Age / DT────────────────────┐"
    },
    {
      "type": "uptime",
      "key": "    Uptime",
      "keyColor": "2",
    },
    {
      "type": "command",
      "key": "  󱦟  Age",
      "keyColor": "2",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "datetime",
      "key": "  󰭖  DateTime",
      "keyColor": "2"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break",
    "break",
  ]
}
